# ─────────────────────────────────────────────────────────────
# NEXA HR & Payroll Platform — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection (Prisma).
#
# DATABASE_URL = the connection the app uses at runtime.
#   • Local Postgres:  postgresql://postgres:postgres@localhost:5432/nexa?schema=public
#   • Supabase (serverless/Vercel): use the **Transaction Pooler** (port 6543) and append
#     ?pgbouncer=true&connection_limit=1
#     e.g. postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL = a direct (non-pooled) connection used by `prisma migrate` / `db push`.
#   • Supabase: the **Direct connection** (port 5432).
#     e.g. postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   • Plain single-server Postgres: set DIRECT_URL to the same value as DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexa?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/nexa?schema=public"

# Auth — generate strong secrets, e.g. `openssl rand -base64 48`
# Separate secrets for access and refresh tokens.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="900"          # seconds (15 min)
REFRESH_TOKEN_TTL="1209600"     # seconds (14 days)

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ── Ready-to-extend seams (not required for core to run) ──
# OAuth (Google / Microsoft)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Redis (caching / rate limiting)
REDIS_URL=""

# Cloudflare R2 (object storage for documents / payslips)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# AI Copilot (Anthropic)
ANTHROPIC_API_KEY=""
