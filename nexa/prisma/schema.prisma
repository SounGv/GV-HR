// ─────────────────────────────────────────────────────────────────────────────
// NEXA HR & Payroll Platform — Prisma schema
//
// Conventions (apply to every business model):
//   • UUID primary keys            → id String @id @default(uuid())
//   • Audit columns                → createdAt / updatedAt / createdById / updatedById
//   • Soft delete                  → deletedAt DateTime?  (null = active)
//   • Multi-tenancy                → companyId on every tenant-scoped table
//
// createdById / updatedById are stored as plain UUID strings (no enforced FK) to
// avoid dozens of noisy back-relations on User. The authoritative, immutable
// change history lives in AuditLog, which DOES have a real FK to the actor.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  PROBATION
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum HolidayType {
  COMPANY
  NATIONAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PAID
}

enum ReviewStatus {
  DRAFT
  FINALIZED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  RETIRED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  COMPLETED
  CANCELLED
}

enum GoalType {
  KPI
  OKR
}

enum TrainingStatus {
  OPEN
  CLOSED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

// ─────────────────────── Tenancy / Org ───────────────────────

model Company {
  id       String  @id @default(uuid())
  name     String
  legalName String?
  taxId    String?
  logoUrl  String?
  timezone String  @default("Asia/Bangkok")
  currency String  @default("THB")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  branches    Branch[]
  departments Department[]
  positions   Position[]
  employees   Employee[]
  users       User[]
  roles       Role[]
  auditLogs   AuditLog[]
  holidays      Holiday[]
  attendance    AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  leaveBalances      LeaveBalance[]
  payrollRecords     PayrollRecord[]
  performanceReviews PerformanceReview[]
  announcements      Announcement[]
  overtimeRequests   OvertimeRequest[]
  assets             Asset[]
  jobPostings        JobPosting[]
  candidates         Candidate[]
  notifications      Notification[]
  goals              Goal[]
  trainingCourses    TrainingCourse[]
  trainingEnrollments TrainingEnrollment[]
  expenses           ExpenseClaim[]
  calendarEvents     CalendarEvent[]

  @@index([deletedAt])
  @@map("companies")
}

model Branch {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  code    String
  address String?
  phone   String?

  // Geofence for attendance clock-in/out
  lat          Float?
  lng          Float?
  radiusMeters Int?   @default(150)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  departments Department[]
  employees   Employee[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("branches")
}

model Department {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name String
  code String

  // Self-referential hierarchy (parent department)
  parentId String?
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  positions Position[]
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("departments")
}

model Position {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  title String
  code  String
  level Int    @default(1) // job level / band

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("positions")
}

// ──────────────────────── Auth / RBAC ────────────────────────

model User {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  // 2FA (ready-to-enable)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // OAuth account linking (ready-to-enable)
  googleId    String?
  microsoftId String?

  lastLoginAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]
  employee      Employee?
  auditLogs     AuditLog[]

  @@unique([companyId, email])
  @@index([companyId, deletedAt])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid())
  // Null companyId = global/system role available to all tenants.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  // Stable key used in code, e.g. "employee:create", "payroll:read"
  key    String @unique
  module String // grouping for the permission matrix UI, e.g. "employee"
  action String // e.g. "create" | "read" | "update" | "delete" | "approve"
  label  String

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String @id @default(uuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store only a hash of the refresh token; supports rotation + revocation.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdIp String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action   String // e.g. "employee.create"
  entity   String // e.g. "Employee"
  entityId String?
  before   Json?
  after    Json?
  ip       String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─────────────────────────── HR: Employee ───────────────────────────

model Employee {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Optional link to a login account (some employees may have no system access).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  employeeCode String

  // Identity
  firstName   String
  lastName    String
  firstNameEn String?
  lastNameEn  String?
  nickname    String?
  email       String?
  phone       String?
  avatarUrl   String?

  gender        Gender?
  dateOfBirth   DateTime?
  nationalId    String? // handle as sensitive / encrypt at rest downstream
  maritalStatus MaritalStatus?

  // Org placement
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)

  // Reporting line (self relation)
  managerId String?
  manager   Employee?  @relation("EmployeeReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("EmployeeReports")

  attendance         AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  payrollRecords     PayrollRecord[]
  performanceReviews PerformanceReview[]
  overtimeRequests   OvertimeRequest[]
  assignedAssets     Asset[]
  notifications      Notification[]
  goals              Goal[]
  enrollments        TrainingEnrollment[]
  expenses           ExpenseClaim[]

  // Employment
  employmentType    EmploymentType @default(FULL_TIME)
  status            EmployeeStatus @default(ACTIVE)
  hireDate          DateTime?
  probationEndDate  DateTime?
  terminationDate   DateTime?

  // Payroll basics (detailed payroll lives in its own module later)
  baseSalary    Decimal? @db.Decimal(12, 2)
  bankName      String?
  bankAccountNo String?

  // Address
  addressLine String?
  district    String?
  province    String?
  postalCode  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([companyId, employeeCode])
  @@index([companyId, deletedAt])
  @@index([companyId, departmentId])
  @@index([companyId, status])
  @@index([managerId])
  @@map("employees")
}

// ─────────────────────────── HR: Holiday calendar ───────────────────────────

model Holiday {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  date          DateTime    @db.Date
  name          String
  type          HolidayType @default(COMPANY)
  notifyEnabled Boolean     @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([companyId, date, name])
  @@index([companyId, date])
  @@map("holidays")
}

// ─────────────────────────── HR: Attendance ───────────────────────────

model AttendanceRecord {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workDate DateTime @db.Date

  clockInAt  DateTime?
  clockOutAt DateTime?

  clockInLat  Float?
  clockInLng  Float?
  clockOutLat Float?
  clockOutLng Float?

  // Distance (metres) from the matched branch geofence at clock-in/out.
  clockInDistance  Float?
  clockOutDistance Float?
  // Branch the geofence matched against (no FK to keep back-relations lean).
  clockInBranchId  String?

  status AttendanceStatus @default(PRESENT)
  note   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
  @@map("attendance_records")
}

// ─────────────────────────── HR: Leave ───────────────────────────

model LeaveRequest {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type      LeaveType
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  halfDay   Boolean   @default(false)
  days      Float
  reason    String?

  status LeaveStatus @default(PENDING)

  // Decider (approver) — stored as ids without FK to keep back-relations lean.
  approverEmployeeId String?
  approverUserId     String?
  decidedAt          DateTime?
  decisionNote       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, status])
  @@index([employeeId, status])
  @@map("leave_requests")
}

model LeaveBalance {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year      Int
  type      LeaveType
  totalDays Float     @default(0)
  usedDays  Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, type])
  @@index([companyId, year])
  @@map("leave_balances")
}

// ─────────────────────────── HR: Payroll ───────────────────────────

model PayrollRecord {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  period      String // "YYYY-MM"
  periodLabel String

  // Line items: [{ label, amount }]
  earnings   Json
  deductions Json

  gross           Int
  totalDeductions Int
  net             Int

  status PayrollStatus @default(DRAFT)
  paidAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([employeeId, period])
  @@index([companyId, period])
  @@map("payroll_records")
}

// ─────────────────────────── HR: Performance ───────────────────────────

model PerformanceReview {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reviewerEmployeeId String?
  reviewerUserId     String?

  cycle        String // e.g. "H1/2569"
  overallScore Float  // 1..5
  band         String
  competencies Json // [{ name, score }]
  strengths    String?
  improvements String?
  summary      String?

  status ReviewStatus @default(FINALIZED)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([employeeId, cycle])
  @@index([companyId, cycle])
  @@map("performance_reviews")
}

// ─────────────────────────── Comms: Announcement ───────────────────────────

model Announcement {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  authorEmployeeId String?
  authorUserId     String?
  authorName       String?

  title  String
  body   String
  pinned Boolean            @default(false)
  status AnnouncementStatus @default(PUBLISHED)

  publishedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, status, pinned])
  @@map("announcements")
}

// ─────────────────────────── HR: Overtime ───────────────────────────

model OvertimeRequest {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date
  startTime       String // "HH:mm"
  endTime         String
  hours           Float
  multiplier      Float    @default(1.5)
  estimatedAmount Int      @default(0)
  reason          String?

  status LeaveStatus @default(PENDING)

  approverEmployeeId String?
  approverUserId     String?
  decidedAt          DateTime?
  decisionNote       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, status])
  @@index([employeeId, status])
  @@map("overtime_requests")
}

// ─────────────────────────── HR: Assets ───────────────────────────

model Asset {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assetCode    String
  name         String
  category     String
  serialNumber String?

  status AssetStatus @default(AVAILABLE)

  assignedToEmployeeId String?
  assignedTo           Employee? @relation(fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  assignedAt           DateTime?

  purchaseDate  DateTime? @db.Date
  purchasePrice Int?
  note          String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([companyId, assetCode])
  @@index([companyId, status])
  @@map("assets")
}

// ─────────────────────────── HR: Recruitment ───────────────────────────

model JobPosting {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title          String
  departmentId   String?
  description    String?
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  openings       Int            @default(1)
  status         JobStatus      @default(OPEN)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  candidates Candidate[]

  @@index([companyId, status])
  @@map("job_postings")
}

model Candidate {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  name      String
  email     String?
  phone     String?
  resumeUrl String?
  note      String?
  stage     CandidateStage @default(APPLIED)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, stage])
  @@index([jobPostingId])
  @@map("candidates")
}

// ─────────────────────────── Comms: Notification ───────────────────────────

model Notification {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title    String
  body     String
  category String  @default("system") // system | ai | leave | payroll | ...
  read     Boolean @default(false)

  createdById String?
  createdAt   DateTime @default(now())

  @@index([employeeId, read])
  @@map("notifications")
}

// ─────────────────────────── Performance: KPI / Goal ───────────────────────────

model Goal {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  ownerEmployeeId String? // who assigned/created the goal (manager)
  ownerUserId     String?

  title       String
  description String?
  type        GoalType   @default(KPI)
  cycle       String // e.g. "H1/2569"
  unit        String     @default("%") // %, ชิ้น, บาท, คน, ...
  targetValue Float
  currentValue Float     @default(0)
  weight      Int        @default(1) // relative importance 1..5
  status      GoalStatus @default(NOT_STARTED)
  dueDate     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, cycle])
  @@index([employeeId, status])
  @@map("goals")
}

// ─────────────────────────── Development: Training ───────────────────────────

model TrainingCourse {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  category      String  @default("ทั่วไป")
  provider      String?
  hours         Float   @default(0)
  location      String?
  scheduledDate DateTime?
  capacity      Int?
  status        TrainingStatus @default(OPEN)

  enrollments TrainingEnrollment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, status])
  @@map("training_courses")
}

model TrainingEnrollment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  courseId String
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  status      EnrollmentStatus @default(ENROLLED)
  score       Float?
  completedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  @@unique([courseId, employeeId])
  @@index([employeeId, status])
  @@map("training_enrollments")
}

// ─────────────────────────── Finance: Expense claim ───────────────────────────

model ExpenseClaim {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title       String
  category    String        @default("other") // travel | food | supplies | accommodation | other
  amount      Decimal       @db.Decimal(12, 2)
  expenseDate DateTime
  description String?
  receiptUrl  String?
  status      ExpenseStatus @default(PENDING)

  approverEmployeeId String?
  approverUserId     String?
  decidedAt          DateTime?
  decisionNote       String?
  paidAt             DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, status])
  @@index([employeeId, status])
  @@map("expense_claims")
}

// ─────────────────────────── Org: Calendar event ───────────────────────────

model CalendarEvent {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        String    @default("event") // event | meeting | deadline
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, startDate])
  @@map("calendar_events")
}
