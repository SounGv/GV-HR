enum EmployeeDocumentType {
  ID_CARD
  DEGREE
  CONTRACT
  WORK_PERMIT
  OTHER
}

/** Scanned personal documents (ID card, degree, contract, work permit) —
 * same base64-data-URL-in-DB pattern as every other attachment in this app,
 * kept as its own table (not a JSON list on Employee) since HR needs to
 * query/list "who's missing a document" across employees. */
model EmployeeDocument {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type    EmployeeDocumentType
  label   String
  fileUrl String

  uploadedAt  DateTime @default(now())
  createdById String?

  @@index([employeeId])
  @@map("employee_documents")
}

/**
 * HR-granted, per-employee override that either (a) turns on AI Assistant
 * access for someone whose role doesn't include ai:read/ai:create, or
 * (b) sets the *data scope* the AI's tools apply for someone who already
 * has ai:read from their role. This sits alongside RBAC, not in place of
 * it — role permissions still gate which tools the AI can call at all;
 * this only gates how much data those tools can see, and whether the AI
 * is reachable at all for someone with no ai:* permission in their role.
 */
model AiAccessGrant {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // One active grant per employee — granting again just updates the scope.
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  scope AiAccessScope @default(TEAM)

  grantedById String?
  grantedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("ai_access_grants")
}

