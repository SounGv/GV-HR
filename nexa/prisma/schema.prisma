// ─────────────────────────────────────────────────────────────────────────────
// NEXA HR & Payroll Platform — Prisma schema
//
// Conventions (apply to every business model):
//   • UUID primary keys            → id String @id @default(uuid())
//   • Audit columns                → createdAt / updatedAt / createdById / updatedById
//   • Soft delete                  → deletedAt DateTime?  (null = active)
//   • Multi-tenancy                → companyId on every tenant-scoped table
//
// createdById / updatedById are stored as plain UUID strings (no enforced FK) to
// avoid dozens of noisy back-relations on User. The authoritative, immutable
// change history lives in AuditLog, which DOES have a real FK to the actor.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" is the Vercel serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime (pooled) connection — e.g. Supabase Transaction Pooler (port 6543).
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) used by `prisma migrate` / `db push`.
  // For a plain single-server Postgres, set DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  PROBATION
  TEMPORARY
  DAILY_WORKER
}

enum CompensationType {
  MONTHLY
  DAILY
  HOURLY
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum HolidayType {
  COMPANY
  NATIONAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

enum AttendanceWorkMode {
  ONSITE
  WFH
  // Set by the server (not user-chosen) when a clock-in/out happens outside
  // the branch geofence with a declared reason — see attendance/service.ts.
  OUTSIDE
}

enum AttendanceMood {
  TERRIBLE
  BAD
  OK
  GOOD
  EXCELLENT
}

enum RecognitionType {
  STAR
  AWARD
  HEART
  POINT
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/** DAY covers full-day and half-day requests (see LeaveRequest.halfDay/days).
 * HOUR is a separate, HR-configurable per-type quota (see LeaveBalance's
 * totalHours/usedHours and Company.leaveQuota{Sick,Personal}Hours) — hours
 * are never converted into/out of the day quota. */
enum LeaveUnit {
  DAY
  HOUR
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
}

enum MeetingResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PayrollStatus {
  DRAFT
  PAID
}

enum ReviewStatus {
  DRAFT
  FINALIZED
}

enum EvaluationCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum EvaluationRaterType {
  SELF
  MANAGER
  PEER
  UPWARD
  HR_EXEC
}

enum EvaluationResponseStatus {
  PENDING
  IN_PROGRESS // draft answers saved, not yet submitted (see saveDraft)
  SUBMITTED
}

/** Question-bank item's answer format. RATING_1_TO_5/PERCENTAGE/NUMERIC_TARGET
 * all score via a numeric value against maxScore; SINGLE_CHOICE/MULTIPLE_CHOICE/
 * YES_NO resolve an option's score the same way EvaluationAnswerType's
 * CHOICE/YES_NO already do; SHORT_TEXT/LONG_TEXT/FILE_EVIDENCE never
 * contribute to the score. */
enum EvaluationQuestionType {
  RATING_1_TO_5
  PERCENTAGE
  NUMERIC_TARGET
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  SHORT_TEXT
  LONG_TEXT
  FILE_EVIDENCE
}

/** HR-facing band derived from Company's evalThreshold* settings — computed
 * and stored on EvaluationParticipant at finalize time so historical results
 * don't silently reclassify if HR later changes the thresholds. */
enum EvaluationScoreStatus {
  GOOD // >= evalThresholdGoodMin
  NEEDS_IMPROVEMENT // evalThresholdWatchMax < score < evalThresholdGoodMin
  WATCH // evalThresholdUrgentMax < score <= evalThresholdWatchMax
  URGENT // <= evalThresholdUrgentMax
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

/** Data-visibility scope for an HR-granted per-manager AI Assistant override. */
enum AiAccessScope {
  TEAM       // direct reports only (managerId == grantee's employeeId), + self
  DEPARTMENT // same departmentId as the grantee
  COMPANY    // no filter — same visibility HR already has
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  RETIRED
}

enum JobStatus {
  OPEN
  CLOSED
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  COMPLETED
  CANCELLED
}

enum GoalType {
  KPI
  OKR
}

enum TrainingStatus {
  OPEN
  CLOSED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

// ─────────────────────── Tenancy / Org ───────────────────────

model Company {
  id           String  @id @default(uuid())
  name         String
  legalName    String?
  taxId        String?
  logoUrl      String? // light logo (data URL or external URL)
  logoDarkUrl  String?
  faviconUrl   String?
  signatureUrl String? // authorized digital signature
  stampUrl     String? // company stamp
  brandColor   String? // hex, e.g. #2563EB
  timezone     String  @default("Asia/Bangkok")
  currency     String  @default("THB")
  language     String  @default("th")

  // Contact / address
  phone         String?
  email         String?
  website       String?
  googleMapsUrl String?
  addressLine   String?
  subDistrict   String?
  district      String?
  province      String?
  postalCode    String?
  country       String? @default("ไทย")

  // Attendance-to-payroll deduction policy — off by default so generating
  // payroll never silently starts docking pay until HR explicitly turns it
  // on. When enabled, generatePayroll() checks each MONTHLY employee's
  // workdays (Mon–Fri minus company Holidays) against attendance/leave
  // records, mirroring the existing calendar "my day status" derivation:
  // no clock-in and no approved leave covering that day → an absence
  // deduction (same day-rate formula as unpaid leave); an AttendanceRecord
  // already marked "LATE" (lib/datetime.ts's existing shift-time check) →
  // a flat late deduction.
  attendanceDeductionEnabled Boolean @default(false)
  lateDeductionPerOccurrence Decimal @default(0) @db.Decimal(12, 2) // baht deducted per late day

  // Default annual leave quota (days/year) per paid leave type — HR-editable
  // company-wide default. Applied lazily: each employee's LeaveBalance row is
  // only created the first time a leave of that type is approved for them in
  // a given year (see leave/service.ts), snapshotting whatever this default
  // was at that moment. Changing this only affects rows not yet created.
  leaveQuotaAnnualDays   Int @default(10)
  leaveQuotaSickDays     Int @default(30)
  leaveQuotaPersonalDays Int @default(3)
  // Separate hour-based quota for the two leave types that support hourly
  // requests — 0 means "not offered", not "unlimited" (see leave/service.ts).
  leaveQuotaSickHours     Int @default(0)
  leaveQuotaPersonalHours Int @default(0)

  // Evaluation score bands (% of weighted max), HR-editable from Settings —
  // never hardcoded in the frontend. Contiguous ascending cut points define
  // 4 bands: <=urgentMax -> URGENT, <=watchMax -> WATCH, <goodMin ->
  // NEEDS_IMPROVEMENT, >=goodMin -> GOOD (see EvaluationScoreStatus).
  evalThresholdUrgentMax Float @default(66.67)
  evalThresholdWatchMax  Float @default(74.99)
  evalThresholdGoodMin   Float @default(83.33)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  branches                    Branch[]
  departments                 Department[]
  positions                   Position[]
  costCenters                 CostCenter[]
  employees                   Employee[]
  users                       User[]
  roles                       Role[]
  auditLogs                   AuditLog[]
  holidays                    Holiday[]
  attendance                  AttendanceRecord[]
  attendanceCorrections       AttendanceCorrectionRequest[]
  leaveRequests               LeaveRequest[]
  leaveBalances               LeaveBalance[]
  payrollRecords              PayrollRecord[]
  payrollPeriods              PayrollPeriod[]
  performanceReviews          PerformanceReview[]
  developmentPlans            DevelopmentPlan[]
  competencies                Competency[]
  competencyCategories        CompetencyCategory[]
  evaluationCampaigns         EvaluationCampaign[]
  evaluationScheduleTemplates EvaluationScheduleTemplate[]
  calibrationSessions         CalibrationSession[]
  evaluationTemplates         EvaluationTemplate[]
  successionPlans             SuccessionPlan[]
  announcements               Announcement[]
  overtimeRequests            OvertimeRequest[]
  assets                      Asset[]
  jobPostings                 JobPosting[]
  candidates                  Candidate[]
  notifications               Notification[]
  goals                       Goal[]
  trainingCourses             TrainingCourse[]
  trainingEnrollments         TrainingEnrollment[]
  expenses                    ExpenseClaim[]
  calendarEvents              CalendarEvent[]
  shiftTemplates              ShiftTemplate[]
  shiftAssignments            ShiftAssignment[]
  shiftSwapRequests           ShiftSwapRequest[]
  approvalWorkflows           ApprovalWorkflow[]
  recognitions                Recognition[]
  approvalRequests            ApprovalRequest[]
  meetings                    Meeting[]
  employeeDocuments           EmployeeDocument[]
  positionCompetencyRequirements PositionCompetencyRequirement[]
  employeeCompetencyLevels       EmployeeCompetencyLevel[]
  aiAccessGrants                 AiAccessGrant[]

  @@index([deletedAt])
  @@map("companies")
}

model Branch {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  code    String
  address String?
  phone   String?

  // Geofence for attendance clock-in/out
  lat          Float?
  lng          Float?
  radiusMeters Int?   @default(150)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  departments Department[]
  employees   Employee[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("branches")
}

model Department {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name String
  code String

  // Self-referential hierarchy (parent department)
  parentId String?
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  positions                   Position[]
  employees                   Employee[]
  evaluationScheduleTemplates EvaluationScheduleTemplate[]
  evaluationQuestions         Competency[]
  evaluationTemplates         EvaluationTemplate[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("departments")
}

model CostCenter {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("cost_centers")
}

model Position {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  title String
  code  String
  level Int    @default(1) // job level / band

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  employees       Employee[]
  successionPlans SuccessionPlan[]
  competencyRequirements PositionCompetencyRequirement[]
  evaluationQuestions     Competency[]
  evaluationTemplates     EvaluationTemplate[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt])
  @@map("positions")
}

enum SuccessionReadiness {
  READY_NOW
  ONE_TO_TWO_YEARS
  THREE_TO_FIVE_YEARS
  NOT_READY
}

model SuccessionPlan {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  incumbentEmployeeId String?
  incumbentEmployee   Employee? @relation("SuccessionPlanIncumbent", fields: [incumbentEmployeeId], references: [id], onDelete: SetNull)

  notes String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  candidates SuccessionCandidate[]

  @@unique([companyId, positionId])
  @@map("succession_plans")
}

model SuccessionCandidate {
  id     String         @id @default(uuid())
  planId String
  plan   SuccessionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation("SuccessionCandidacy", fields: [employeeId], references: [id], onDelete: Cascade)

  readiness SuccessionReadiness
  note      String?
  rank      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, employeeId])
  @@map("succession_candidates")
}

// ──────────────────────── Auth / RBAC ────────────────────────

model User {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  // 2FA (ready-to-enable)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // OAuth account linking (ready-to-enable)
  googleId    String?
  microsoftId String?

  lastLoginAt DateTime?

  // Brute-force protection for login + MFA verify (shared budget — either
  // wrong password or wrong TOTP/recovery code counts against the same
  // limit, since a valid password is a prerequisite to even reach MFA).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  employee               Employee?
  auditLogs              AuditLog[]

  @@unique([companyId, email])
  @@index([companyId, deletedAt])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid())
  // Null companyId = global/system role available to all tenants.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  // Stable key used in code, e.g. "employee:create", "payroll:read"
  key    String @unique
  module String // grouping for the permission matrix UI, e.g. "employee"
  action String // e.g. "create" | "read" | "update" | "delete" | "approve"
  label  String

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store only a hash of the refresh token; supports rotation + revocation.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdIp String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store only a hash of the reset token; single-use, short-lived.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdIp String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Single-use recovery codes for 2FA — shown once at enrollment, used when the
// authenticator device is unavailable (lost phone, etc.) instead of a TOTP code.
model TwoFactorRecoveryCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String    @unique
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action    String // e.g. "employee.create"
  entity    String // e.g. "Employee"
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─────────────────────────── HR: Employee ───────────────────────────

model Employee {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Optional link to a login account (some employees may have no system access).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // LINE account link (for push notifications) — the employee links it
  // themselves via a short-lived code, confirmed through the LINE webhook.
  lineUserId            String?   @unique
  lineLinkCode          String?   @unique
  lineLinkCodeExpiresAt DateTime?

  employeeCode String

  // Identity
  firstName   String
  lastName    String
  firstNameEn String?
  lastNameEn  String?
  nickname    String?
  email       String?
  phone       String?
  avatarUrl   String?

  gender        Gender?
  dateOfBirth   DateTime?
  nationalId    String? // handle as sensitive / encrypt at rest downstream
  maritalStatus MaritalStatus?

  // Org placement
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  // Reporting line (self relation)
  managerId String?
  manager   Employee?  @relation("EmployeeReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Employee[] @relation("EmployeeReports")

  attendance                 AttendanceRecord[]
  attendanceCorrections      AttendanceCorrectionRequest[]
  leaveRequests              LeaveRequest[]
  leaveBalances              LeaveBalance[]
  payrollRecords             PayrollRecord[]
  performanceReviews         PerformanceReview[]
  developmentPlans           DevelopmentPlan[]
  evaluationParticipants     EvaluationParticipant[]
  overtimeRequests           OvertimeRequest[]
  assignedAssets             Asset[]
  notifications              Notification[]
  goals                      Goal[]
  enrollments                TrainingEnrollment[]
  expenses                   ExpenseClaim[]
  shiftAssignments           ShiftAssignment[]
  shiftSwapRequestsMade      ShiftSwapRequest[]            @relation("ShiftSwapRequester")
  shiftSwapRequestsReceived  ShiftSwapRequest[]            @relation("ShiftSwapTarget")
  recognitions               Recognition[]
  successionPlansAsIncumbent SuccessionPlan[]              @relation("SuccessionPlanIncumbent")
  successionCandidacies      SuccessionCandidate[]         @relation("SuccessionCandidacy")
  meetingsOrganized         Meeting[]                      @relation("MeetingOrganizer")
  meetingInvites            MeetingAttendee[]              @relation("MeetingAttendee")
  documents                 EmployeeDocument[]
  competencyLevels          EmployeeCompetencyLevel[]
  aiAccessGrant             AiAccessGrant?

  // Employment
  employmentType   EmploymentType @default(FULL_TIME)
  status           EmployeeStatus @default(ACTIVE)
  hireDate         DateTime?
  probationEndDate DateTime?
  terminationDate  DateTime?

  // Payroll basics (detailed payroll lives in its own module later)
  // How this employee is paid — orthogonal to employmentType (a PART_TIME
  // hire could still be salaried; a FULL_TIME hire could be daily-wage
  // labor). Only the rate field matching compensationType is expected to be
  // set; generatePayroll() picks the base-pay formula from this.
  compensationType CompensationType @default(MONTHLY)
  baseSalary       Decimal?         @db.Decimal(12, 2) // MONTHLY
  dailyRate        Decimal?         @db.Decimal(12, 2) // DAILY — × actual attendance days in the period
  hourlyRate       Decimal?         @db.Decimal(12, 2) // HOURLY — × actual clocked hours in the period
  bankName         String?
  bankAccountNo    String?

  bankBranch String?

  // Personal tax deductions (ลดหย่อนภาษีส่วนบุคคล) — feeds computePayroll()'s
  // withholding-tax estimate. All default to "none" so WHT stays at the
  // conservative baseline (standard allowance only) until HR/the employee
  // declares these.
  taxSpouseNoIncome     Boolean @default(false) // คู่สมรสไม่มีเงินได้ — ลดหย่อน 60,000/ปี
  taxChildrenStandard   Int     @default(0) // บุตร ลดหย่อนคนละ 30,000/ปี (คนแรกทุกกรณี + คนอื่นที่เกิดก่อนปี 2561)
  taxChildrenEnhanced   Int     @default(0) // บุตรคนที่ 2 เป็นต้นไป เกิดปี 2561+ — ลดหย่อนคนละ 60,000/ปี
  taxParentCareCount    Int     @default(0) // อุปการะบิดามารดา (ตนเอง+คู่สมรส รวมสูงสุด 4 คน) — 30,000/คน/ปี
  taxLifeInsurance      Decimal @default(0) @db.Decimal(12, 2) // เบี้ยประกันชีวิต — ลดหย่อนสูงสุด 100,000/ปี
  taxHealthInsurance    Decimal @default(0) @db.Decimal(12, 2) // เบี้ยประกันสุขภาพ — รวมกับประกันชีวิตไม่เกิน 100,000/ปี

  // Address
  addressLine String?
  subDistrict String?
  district    String?
  province    String?
  postalCode  String?
  country     String? @default("ไทย")

  // Emergency contact
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([companyId, employeeCode])
  @@index([companyId, deletedAt])
  @@index([companyId, departmentId])
  @@index([companyId, status])
  @@index([managerId])
  @@map("employees")
}

// ─────────────────────────── HR: Holiday calendar ───────────────────────────

model Holiday {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  date          DateTime    @db.Date
  name          String
  type          HolidayType @default(COMPANY)
  notifyEnabled Boolean     @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([companyId, date, name])
  @@index([companyId, date])
  @@map("holidays")
}

// ─────────────────────────── HR: Attendance ───────────────────────────

model AttendanceRecord {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workDate DateTime @db.Date

  clockInAt  DateTime?
  clockOutAt DateTime?

  clockInLat  Float?
  clockInLng  Float?
  clockOutLat Float?
  clockOutLng Float?

  // Distance (metres) from the matched branch geofence at clock-in/out.
  clockInDistance  Float?
  clockOutDistance Float?
  clockInAccuracy  Float?
  clockOutAccuracy Float?
  // Branch the geofence matched against (no FK to keep back-relations lean).
  clockInBranchId  String?

  // Selfie proof + device metadata (data URLs / UA string)
  clockInPhotoUrl  String?
  clockOutPhotoUrl String?
  clockInDevice    String?
  clockOutDevice   String?

  // Set when the branch geofence was verified by scanning the branch's QR
  // code instead of (or in addition to) GPS — see the attendance service.
  clockInViaQr  Boolean @default(false)
  clockOutViaQr Boolean @default(false)

  // Single break window per day (start/end pair) — not a multi-break log.
  breakStartAt DateTime?
  breakEndAt   DateTime?

  // Employee-declared mode at clock-in (WFH skips the geofence requirement).
  workMode      AttendanceWorkMode @default(ONSITE)
  // Self-reported wellbeing check at clock-out.
  moodOut       AttendanceMood?
  // Clocked out before the shift end (see lib/datetime.ts SHIFT_END_MIN).
  earlyLeaveOut Boolean            @default(false)

  status AttendanceStatus @default(PRESENT)
  note   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
  @@map("attendance_records")
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * Employee-submitted request to fix a wrong clock-in/out time — on approval,
 * the manager's decision is applied straight to the matching AttendanceRecord.
 */
model AttendanceCorrectionRequest {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workDate          DateTime  @db.Date
  requestedClockIn  DateTime?
  requestedClockOut DateTime?
  reason            String

  status AttendanceCorrectionStatus @default(PENDING)

  approverEmployeeId String?
  approverUserId     String?
  decidedAt          DateTime?
  decisionNote       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, status])
  @@index([employeeId, status])
  @@map("attendance_correction_requests")
}

// ─────────────────────────── HR: Recognition ───────────────────────────

model Recognition {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  givenByUserId     String
  givenByEmployeeId String?

  type    RecognitionType
  points  Int             @default(0)
  message String?

  createdAt   DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?

  @@index([companyId, employeeId])
  @@index([companyId, type])
  @@map("recognitions")
}

// ─────────────────────────── HR: Leave ───────────────────────────

model LeaveRequest {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type          LeaveType
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  halfDay       Boolean   @default(false)
  days          Float
  // Hour-based leave (currently SICK/PERSONAL only, see leave/days.ts's
  // HOURLY_LEAVE_TYPES) — startDate must equal endDate, days is 0, and these
  // three carry the actual request instead. startTime/endTime are "HH:mm"
  // wall-clock strings (no timezone math needed — they're paired with the
  // already-known startDate).
  unit          LeaveUnit @default(DAY)
  hours         Float?
  startTime     String?
  endTime       String?
  reason        String?
  // Supporting document (e.g. a medical certificate) — a client-uploaded
  // data URL or an https link, same pattern as other attachment fields.
  attachmentUrl String?

  status LeaveStatus @default(PENDING)

  // Decider (approver) — stored as ids without FK to keep back-relations lean.
  approverEmployeeId String?
  approverUserId     String?
  decidedAt          DateTime?
  decisionNote       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, status])
  @@index([employeeId, status])
  @@map("leave_requests")
}

model LeaveBalance {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year      Int
  type      LeaveType
  totalDays Float     @default(0)
  usedDays  Float     @default(0)
  // Separate hour-based quota tracking (see LeaveRequest.unit) — never
  // converted to/from totalDays/usedDays, an intentionally independent pool.
  totalHours Float    @default(0)
  usedHours  Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, type])
  @@index([companyId, year])
  @@map("leave_balances")
}

model Meeting {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  organizerEmployeeId String
  organizer            Employee @relation("MeetingOrganizer", fields: [organizerEmployeeId], references: [id], onDelete: Cascade)

  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  status      MeetingStatus @default(SCHEDULED)

  attendees MeetingAttendee[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, organizerEmployeeId])
  @@index([companyId, startAt])
  @@map("meetings")
}

model MeetingAttendee {
  id        String  @id @default(uuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation("MeetingAttendee", fields: [employeeId], references: [id], onDelete: Cascade)

  status      MeetingResponseStatus @default(PENDING)
  respondedAt DateTime?
  note        String?

  createdAt DateTime @default(now())

  @@unique([meetingId, employeeId])
  @@index([employeeId, status])
  @@map("meeting_attendees")
}

// ─────────────────────────── HR: Payroll ───────────────────────────

model PayrollRecord {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  period      String // "YYYY-MM"
  periodLabel String

  // Line items: [{ label, amount }]
  earnings   Json
  deductions Json

  // HR-entered extra earnings/deductions for this period (allowance, bonus,
  // advance recovery, other) — { earnings: LineItem[], deductions: LineItem[] }.
  // Kept separate from the auto-computed base so re-running "generate" for
  // the period (which recomputes salary/OT/tax/SSO) never wipes these out —
  // see generatePayroll() in payroll/service.ts.
  manualAdjustments Json?

  // HR remark printed on the payslip (e.g. "รวมค่าคอมมิชชั่นไตรมาสนี้").
  note String?

  gross           Int
  totalDeductions Int
  net             Int

  status PayrollStatus @default(DRAFT)
  paidAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([employeeId, period])
  @@index([companyId, period])
  @@map("payroll_records")
}

/**
 * Company-wide payroll period close/lock — one row per company+period, only
 * ever created when someone with `payroll:approve` explicitly closes it.
 * Absence of a row means the period is still open. Closing blocks
 * generate/adjust for every record in that period, including brand-new ones
 * (unlike the existing per-record PAID lock, which only protects records
 * already marked paid).
 */
model PayrollPeriod {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  period String // "YYYY-MM"

  closedAt   DateTime @default(now())
  closedById String?

  @@unique([companyId, period])
  @@map("payroll_periods")
}

// ─────────────────────────── HR: Performance ───────────────────────────

model PerformanceReview {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reviewerEmployeeId String?
  reviewerUserId     String?

  cycle        String // e.g. "H1/2569"
  overallScore Float // 1..5
  band         String
  competencies Json // [{ name, score }]
  strengths    String?
  improvements String?
  summary      String?

  status ReviewStatus @default(FINALIZED)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([employeeId, cycle])
  @@index([companyId, cycle])
  @@map("performance_reviews")
}

enum DevelopmentPlanStatus {
  ACTIVE
  COMPLETED
}

enum DevelopmentItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

/**
 * Individual Development Plan (IDP) — one per employee per cycle, employee
 * self-service by design (they own their own growth plan; HR/manager can
 * view but the employee authors it). Items can be freely custom-authored, or
 * seeded from the employee's own lowest-scoring competencies on their latest
 * PerformanceReview (matched by name at suggestion time — that review only
 * stores a competency *name* snapshot, not a FK, so there's nothing durable
 * to link items back to).
 */
model DevelopmentPlan {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  cycle  String // e.g. "H2/2569" — same free-text convention as PerformanceReview.cycle
  status DevelopmentPlanStatus @default(ACTIVE)

  // Set when this plan was auto-created (or reused) because an
  // EvaluationParticipant's score fell at/under the URGENT threshold — see
  // maybeCreateImprovementPlan in campaign/service.ts. Nullable: a plan an
  // employee/manager authored by hand has neither.
  participantId String?
  participant   EvaluationParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  managerId     String?
  autoGenerated Boolean @default(false)

  items DevelopmentItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  @@unique([employeeId, cycle])
  @@map("development_plans")
}

model DevelopmentItem {
  id     String          @id @default(uuid())
  planId String
  plan   DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  title       String
  description String?
  method      String? // e.g. "อบรม", "พี่เลี้ยง (mentoring)", "ฝึกปฏิบัติจริง", "ศึกษาด้วยตนเอง" — free text
  targetDate  DateTime?              @db.Date
  status      DevelopmentItemStatus  @default(NOT_STARTED)
  // Simple dated update log: [{ at: ISOString, note: string }] — same
  // free-form JSON-array-of-entries pattern already used for payroll line
  // items elsewhere in this schema.
  progressNotes Json?

  // Improvement-plan-specific fields (spec: สาเหตุ/ผู้รับผิดชอบ/วันเริ่ม/
  // วันติดตาม/หมายเหตุหัวหน้า/ความคิดเห็นพนักงาน) — additive alongside the
  // pre-existing generic IDP fields above so a hand-authored IDP item (no
  // "problem" to root-cause) keeps working exactly as before.
  problemDescription   String?
  responsiblePersonId  String?
  startDate            DateTime? @db.Date
  followUpDate         DateTime? @db.Date
  managerNote          String?
  employeeNote         String?
  completedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("development_items")
}

// ─────────────── Performance & Talent: Competency / Evaluation Campaigns ───────────────
// Additive alongside PerformanceReview (single-rater ad-hoc reviews keep working
// unchanged) — Campaigns are a separate, more structured multi-rater workflow.

model CompetencyCategory {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  order     Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  competencies Competency[]

  @@unique([companyId, name])
  @@map("competency_categories")
}

model Competency {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Short real-world example shown under the criterion in the rating form
  // (Favpo-style "ตัวอย่างพฤติกรรม:" line), distinct from `description`.
  exampleBehavior String?
  categoryId      String?
  category        CompetencyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order           Int                 @default(0)
  active          Boolean             @default(true)

  // Question-bank fields — this same reusable, company-scoped row doubles as
  // the "evaluation_question_bank" entry a Template pulls a question from
  // (see EvaluationTemplateQuestion.competencyId), instead of a parallel
  // table duplicating name/description/category/active. Legacy consumers
  // (EvaluationCampaignCompetency, EvaluationScheduleCompetency) are
  // untouched by these additions.
  questionType   EvaluationQuestionType @default(RATING_1_TO_5)
  maxScore       Float                  @default(5)
  defaultWeight  Int                    @default(1)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId     String?
  position       Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  // Free-text tag matching a cycle's intended use (e.g. "PROBATION",
  // "MONTHLY", "QUARTERLY", "ANNUAL", "WAREHOUSE", "SALES") — not an enum,
  // since HR should be able to introduce a new evaluation type without a
  // migration; used only as a filter hint in the Question Bank UI.
  evaluationType String?
  isRequired     Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  campaignLinks EvaluationCampaignCompetency[]
  scheduleLinks EvaluationScheduleCompetency[]
  positionRequirements PositionCompetencyRequirement[]
  employeeLevels       EmployeeCompetencyLevel[]
  bankQuestions        EvaluationTemplateQuestion[]

  @@unique([companyId, name])
  @@map("competencies")
}

// ───────── Competency Matrix: position requirements + assessed employee levels ─────────

/** How proficient a position expects an employee to be in a given competency (1-5). */
model PositionCompetencyRequirement {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  positionId   String
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  requiredLevel Int // 1-5

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([positionId, competencyId])
  @@index([companyId])
  @@map("position_competency_requirements")
}

/** An employee's current assessed proficiency in a competency (1-5) — manually rated by HR/manager. */
model EmployeeCompetencyLevel {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  level        Int // 1-5
  note         String?
  assessedAt   DateTime @default(now())
  assessedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, competencyId])
  @@index([companyId])
  @@map("employee_competency_levels")
}

model EvaluationCampaign {
  id          String                   @id @default(uuid())
  companyId   String
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  cycle       String // e.g. "H1/2569"
  startDate   DateTime
  endDate     DateTime
  status      EvaluationCampaignStatus @default(DRAFT)
  // Which rater direction(s) this round collects — defaults to both so every
  // campaign created before this field existed keeps behaving unchanged.
  raterTypes  EvaluationRaterType[]    @default([SELF, MANAGER])
  // Whether the competency set was AI-drafted (AI Performance Designer), and why.
  aiGenerated Boolean                  @default(false)
  aiRationale String?

  // Set when this campaign was auto-generated by a recurring schedule
  // template, rather than created manually by HR.
  scheduleTemplateId String?
  scheduleTemplate   EvaluationScheduleTemplate? @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)

  // New Evaluation Form Builder path (Template -> Section -> Question),
  // additive alongside the pre-existing Competency/raterTypes scoring path
  // above — a campaign uses ONE of the two, never both. `templateSnapshot`
  // is a frozen copy of the template's sections/questions taken at create
  // time, so editing the template later never changes what a live or past
  // campaign actually asked (see CampaignTemplateSnapshot in types.ts).
  templateId       String?
  template         EvaluationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateSnapshot Json?

  // By when the reviewee must acknowledge their finalized result, and when
  // HR/manager should follow up on any resulting improvement plan — both
  // optional, set at cycle-creation time (see the wizard's dates step).
  acknowledgeDueDate DateTime?
  followUpDate       DateTime?
  publishedAt        DateTime? // DRAFT -> ACTIVE transition timestamp
  closedAt           DateTime? // -> CLOSED transition timestamp

  // "สร้างรอบใหม่จากรอบเดิม" — set when this campaign was cloned from an
  // earlier one. The source campaign/its results are never touched by a
  // clone (it gets its own template snapshot + participants + raters).
  clonedFromId String?
  clonedFrom   EvaluationCampaign?  @relation("CampaignClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones       EvaluationCampaign[] @relation("CampaignClone")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  competencies        EvaluationCampaignCompetency[]
  participants        EvaluationParticipant[]
  calibrationSessions CalibrationSession[]

  @@index([companyId, status])
  @@map("evaluation_campaigns")
}

model EvaluationCampaignCompetency {
  id           String             @id @default(uuid())
  campaignId   String
  campaign     EvaluationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency         @relation(fields: [competencyId], references: [id])
  weight       Int                @default(1) // importance weight 1-5

  @@unique([campaignId, competencyId])
  @@map("evaluation_campaign_competencies")
}

model EvaluationParticipant {
  id         String             @id @default(uuid())
  campaignId String
  campaign   EvaluationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Computed once the manager response is submitted (see computeScore).
  overallScore Float?
  band         String?
  finalizedAt  DateTime?

  // Weighted-score breakdown — stored explicitly (not just the final
  // percent) so a result never has to be recomputed from raw responses to
  // show its components. rawScore/maxScore are already weight-applied sums;
  // scorePercent = rawScore/maxScore*100, rounded, is what scoreStatus bands.
  rawScore       Float?
  maxScore       Float?
  scorePercent   Float?
  questionCount  Int?
  evaluatorCount Int?
  // Banded from Company.evalThreshold* at finalize time — frozen onto the
  // row so a later threshold change never silently reclassifies a past
  // result (mirrors why templateSnapshot freezes campaign content).
  scoreStatus EvaluationScoreStatus?
  // The lowest-scoring question(s) at finalize time, for the "หัวข้อที่
  // คะแนนต่ำสุด" dashboard chart and the auto-generated improvement plan's
  // suggested topics — [{ competencyId, label, score, maxScore }].
  lowestTopics Json?

  employeeAcknowledged Boolean   @default(false)
  acknowledgedAt       DateTime?

  // Set during a calibration session — the human-reconciled score/band that
  // supersedes overallScore/band for reporting once present, plus the
  // 9-box grid's potential axis (there is no automatic way to derive
  // "potential" from evaluation responses, so it's set manually here).
  calibrationSessionId String?
  calibrationSession   CalibrationSession? @relation(fields: [calibrationSessionId], references: [id], onDelete: SetNull)
  calibratedScore      Float?
  calibratedBand       String?
  potential            PotentialLevel?
  potentialNote        String?

  responses         EvaluationResponse[]
  improvementPlans  DevelopmentPlan[]

  @@unique([campaignId, employeeId])
  @@map("evaluation_participants")
}

enum PotentialLevel {
  LOW
  MEDIUM
  HIGH
}

enum CalibrationStatus {
  DRAFT
  COMPLETED
}

model CalibrationSession {
  id         String             @id @default(uuid())
  companyId  String
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   EvaluationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  status     CalibrationStatus  @default(DRAFT)

  facilitatorEmployeeId String?
  notes                 String?
  completedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants EvaluationParticipant[]

  @@index([companyId, campaignId])
  @@map("calibration_sessions")
}

model EvaluationResponse {
  id              String                @id @default(uuid())
  participantId   String
  participant     EvaluationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  raterType       EvaluationRaterType
  raterEmployeeId String

  scores       Json // [{ competencyId, score }] — legacy Competency-based path
  strengths    String?
  improvements String?
  summary      String?

  // New Template-based path: [{ questionId, value }] — value is a number for
  // NUMERIC/LETTER/CHOICE/YES_NO (already resolved to the option's score) or
  // free text for LONG_TEXT. Only populated when the parent campaign has a
  // templateSnapshot; `scores` above is simply left `[]` in that case.
  answers Json?

  // Supporting files the rater attaches (reports, screenshots) — same
  // base64-data-URL-in-DB pattern as every other attachment in this app
  // (no server upload route exists anywhere), just stored as a JSON array.
  evidenceUrls Json? // string[]

  status      EvaluationResponseStatus @default(PENDING)
  dueDate     DateTime?
  submittedAt DateTime?
  createdAt   DateTime                 @default(now())

  // "Request Reopen" — after SUBMITTED, the rater can no longer edit
  // directly; requesting a reopen just flags intent + reason. Only HR/an
  // authorized approver can actually act on it (see reopenResponse in
  // service.ts), which reverts status to PENDING and is always audit-logged.
  reopenRequested     Boolean   @default(false)
  reopenRequestedAt   DateTime?
  reopenRequestNote   String?
  reopenedAt          DateTime?
  reopenedById        String?

  @@unique([participantId, raterType, raterEmployeeId])
  @@map("evaluation_responses")
}

// Recurring template that periodically auto-generates a new EvaluationCampaign
// (DRAFT status, scoped to one department) via a scheduled cron job.
model EvaluationScheduleTemplate {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  intervalMonths Int @default(1) // 1=monthly, 3=quarterly, 6=biannual, 12=annual
  durationDays   Int @default(14) // generated campaign's open window length

  raterTypes EvaluationRaterType[] @default([SELF, MANAGER])

  // When set, the cron generates a Template-based campaign (snapshotting
  // this Evaluation Template) instead of the legacy Competency-based one —
  // mutually exclusive with `competencies` below, same as on EvaluationCampaign.
  evaluationTemplateId String?
  evaluationTemplate   EvaluationTemplate? @relation(fields: [evaluationTemplateId], references: [id], onDelete: SetNull)

  nextRunAt DateTime
  lastRunAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  competencies       EvaluationScheduleCompetency[]
  generatedCampaigns EvaluationCampaign[]

  @@index([active, nextRunAt])
  @@map("evaluation_schedule_templates")
}

model EvaluationScheduleCompetency {
  id           String                     @id @default(uuid())
  templateId   String
  template     EvaluationScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency                 @relation(fields: [competencyId], references: [id])
  weight       Int                        @default(1) // importance weight 1-5

  @@unique([templateId, competencyId])
  @@map("evaluation_schedule_competencies")
}

// ──────────────────── Evaluation Form Builder (additive) ────────────────────
// HR-authored form: Template -> Section -> Question, fully independent of the
// legacy Competency/raterTypes scoring path above. A campaign picks EITHER a
// Template (see EvaluationCampaign.templateId/templateSnapshot) OR a set of
// Competencies — never both — so nothing here touches existing campaigns,
// responses, or the standalone Competency library.

enum EvaluationTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EvaluationAnswerType {
  NUMERIC
  LETTER
  CHOICE
  YES_NO
  LONG_TEXT
  SHORT_TEXT // never scored, same as LONG_TEXT — UI hint only (single-line input)
  FILE_EVIDENCE // never scored — pairs with EvaluationResponse.evidenceUrls
}

model EvaluationTemplate {
  id          String                   @id @default(uuid())
  companyId   String
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      EvaluationTemplateStatus @default(DRAFT)
  aiGenerated Boolean                  @default(false)
  aiRationale String?

  // Free-text filter hint (see Competency.evaluationType) — e.g. "PROBATION",
  // "MONTHLY", "QUARTERLY", "ANNUAL", matching the sample templates HR is
  // expected to build (ประเมินทดลองงาน/รายเดือน/รายไตรมาส/รายปี/...).
  evaluationType String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId     String?
  position       Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)

  // "คัดลอกแบบประเมิน" — version increments on every clone descended from
  // the same lineage; clonedFrom always points at the immediate parent, not
  // necessarily version 1, so the chain can be walked either direction.
  version      Int    @default(1)
  clonedFromId String?
  clonedFrom   EvaluationTemplate?  @relation("TemplateClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones       EvaluationTemplate[] @relation("TemplateClone")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  sections          EvaluationTemplateSection[]
  campaigns         EvaluationCampaign[]
  scheduleTemplates EvaluationScheduleTemplate[]

  @@index([companyId, status])
  @@map("evaluation_templates")
}

model EvaluationTemplateSection {
  id         String             @id @default(uuid())
  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int                @default(0)

  questions EvaluationTemplateQuestion[]

  @@index([templateId, order])
  @@map("evaluation_template_sections")
}

model EvaluationTemplateQuestion {
  id         String                    @id @default(uuid())
  sectionId  String
  section    EvaluationTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text       String
  helpText   String? // ตัวอย่างพฤติกรรม / คำอธิบายเพิ่มเติม
  answerType EvaluationAnswerType

  // NUMERIC: [{ value: "1", score: 1 }, ..., { value: "5", score: 5 }]
  // LETTER/CHOICE: [{ value: "A", label: "ดี", score: 3 }, ...]
  // YES_NO: [{ value: "YES", label: "ใช่", score: 1 }, { value: "NO", label: "ไม่ใช่", score: 0 }]
  // LONG_TEXT: null — free text, never contributes to the overall score.
  options Json?

  weight   Int     @default(1)
  required Boolean @default(true)
  order    Int     @default(0)

  // Which rater types see/answer this question — empty means everyone.
  // Lets one shared template restrict a sensitive question (e.g. only
  // MANAGER/HR_EXEC see a compensation-related item) instead of forcing HR
  // to build a separate template per rater type.
  visibleTo EvaluationRaterType[] @default([])

  // Set when this question was pulled from the reusable Question Bank
  // (Competency, see the model's doc comment) rather than authored ad-hoc —
  // text/helpText/weight above are copied at add-time so they can still be
  // tweaked per-template without mutating the shared bank entry, but the
  // link lets the UI show "used in N templates/cycles" back on the bank
  // item and lets a future bulk-refresh reapply bank edits if HR wants that.
  competencyId String?
  competency   Competency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)

  @@index([sectionId, order])
  @@map("evaluation_template_questions")
}

