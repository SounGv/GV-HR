// ─────────────────────────── Performance: KPI / Goal ───────────────────────────

model Goal {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  ownerEmployeeId String? // who assigned/created the goal (manager)
  ownerUserId     String?

  // OKR hierarchy: an Objective (type=OKR, parentGoalId=null) can have Key
  // Results — child Goals of its own. Only one level deep (a Key Result's
  // own parentGoalId is never itself set to a goal that already has a
  // parent). KPI-type goals never set this; they stay flat as today.
  parentGoalId String?
  parent       Goal?   @relation("GoalKeyResults", fields: [parentGoalId], references: [id], onDelete: Cascade)
  keyResults   Goal[]  @relation("GoalKeyResults")

  title        String
  description  String?
  type         GoalType   @default(KPI)
  cycle        String // e.g. "H1/2569"
  unit         String     @default("%") // %, ชิ้น, บาท, คน, ...
  targetValue  Float
  currentValue Float      @default(0)
  weight       Int        @default(1) // relative importance 1..5
  status       GoalStatus @default(NOT_STARTED)
  dueDate      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([companyId, cycle])
  @@index([employeeId, status])
  @@index([parentGoalId])
  @@map("goals")
}

