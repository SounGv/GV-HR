// One-directional shift coverage request: "give my assigned shift to a
// coworker" — not a bilateral give-and-take swap. Approved by the
// requester's manager or anyone holding shift:approve, same model as
// Leave/Overtime requests (reuses LeaveStatus for an identical shape).
model ShiftSwapRequest {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignmentId String
  assignment   ShiftAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  requesterEmployeeId String
  requesterEmployee   Employee @relation("ShiftSwapRequester", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  targetEmployeeId    String
  targetEmployee      Employee @relation("ShiftSwapTarget", fields: [targetEmployeeId], references: [id], onDelete: Cascade)

  status             LeaveStatus @default(PENDING)
  reason             String?
  approverEmployeeId String?
  approverUserId     String?
  decidedAt          DateTime?
  decisionNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@map("shift_swap_requests")
}

// ─────────────────────────── Process: Approval workflow ───────────────────────────

